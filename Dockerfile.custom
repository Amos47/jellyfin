# Custom Jellyfin server image: the official jellyfin/jellyfin:12.2 image with the server binaries replaced by a
# build of this fork, and jellyfin-web replaced by a build of the web fork (~/Code/jellyfin-web, branch custom).
# ffmpeg, the entrypoint and the environment come from the base image.
#
# The web fork is passed as a named build context. Build (home lab, x86-64):
#   docker buildx build --platform linux/amd64 --build-arg RID=linux-x64 \
#       --build-context web=../jellyfin-web \
#       -f Dockerfile.custom -t jellyfin-custom:12.2-homerows --load .
# Build (ARM host): --platform linux/arm64 --build-arg RID=linux-arm64
#
# The server and web stages run on the build machine's own platform (no emulation); only the final image is for the
# target platform. dotnet publish cross-compiles for ${RID}.

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG RID=linux-x64
WORKDIR /src
COPY . .
# The cache mount keeps downloaded NuGet packages between builds, so a flaky
# network only costs a retry.
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish Jellyfin.Server/Jellyfin.Server.csproj \
    -c Release -r ${RID} --self-contained true -p:DebugType=none -o /out

FROM --platform=$BUILDPLATFORM node:24 AS webbuild
WORKDIR /web
COPY --from=web package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY --from=web . .
RUN npm run build:production

FROM jellyfin/jellyfin:12.2
# Replace everything in /jellyfin with the fork's server and web builds.
RUN rm -rf /jellyfin/*
COPY --from=build /out/ /jellyfin/
COPY --from=webbuild /web/dist/ /jellyfin/jellyfin-web/
